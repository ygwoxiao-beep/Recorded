# --- LiteLLM 网关（OpenAI 兼容，自托管）---
# 文档: https://github.com/BerriAI/litellm | https://docs.litellm.ai/docs/simple_proxy
# 启动网关: npm run litellm:up  （需 Docker，并复制本文件为 .env 后填写下列变量）
#
# OpenAI 平台密钥，仅由 LiteLLM 容器使用；前端/脚本用 LITELLM_MASTER_KEY 调网关，不暴露 OpenAI Key。
OPENAI_API_KEY="sk-your-openai-key"
# 调用网关时: Authorization: Bearer <LITELLM_MASTER_KEY>
LITELLM_MASTER_KEY="sk-litellm-local-dev"
# 网关地址（litellm:smoke 直连；Vite 代理目标，默认 http://127.0.0.1:4000）
LITELLM_PROXY_URL="http://127.0.0.1:4000"
# 可选: npm run litellm:smoke 使用的模型名，须与 litellm/config.yaml 中 model_name 一致
#LITELLM_SMOKE_MODEL="gpt-4o-mini"
